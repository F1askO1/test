# Node.js 24 LTS. Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/slopemate.sqlite
# Browser-only local development. Must be false in production.
DEV_AUTH=true
# Obtain from @BotFather. Leave blank for browser development.
BOT_TOKEN=
# Public HTTPS origin, without a trailing slash; required when BOT_TOKEN is set.
APP_URL=
# Optional comma-separated exact origins; same-origin production needs none.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only behind a trusted reverse proxy, otherwise 0.
TRUST_PROXY=loopback
# Telegram requests only: leave empty for direct access. Find the actual port in Karing.
# SOCKS5h resolves Telegram DNS through the proxy; SOCKS5 uses the local resolver.
TELEGRAM_PROXY_URL=
# Optional: disable polling while keeping private production HTTP available.
BOT_ENABLED=false
# Cloudflare launcher settings. Executable path can contain spaces; do not add quotes.
CLOUDFLARED_PATH=
TUNNEL_PROTOCOL=http2
TUNNEL_EDGE_IP_VERSION=4
# Stable deployment: external = preconfigured fixed HTTPS origin; quick-test = temporary Cloudflare only.
PUBLIC_ENDPOINT_MODE=external
# local = run on this Windows host; remote = only monitor a server deployment (no local bot/tunnel).
RUN_TARGET=local
# Non-secret stable identity, e.g. generate a UUID; must match the server for endpoint verification.
DEPLOYMENT_ID=
# Optional private diagnostics bearer; generate a random 32-byte hex value locally. Never publish.
DIAGNOSTICS_TOKEN=
# SOCKS handshake deadline; socket idle timeout is removed after handshake.
TELEGRAM_CONNECT_TIMEOUT_MS=10000
# Absolute RPC deadline includes DNS, SOCKS, TLS and HTTP. Must exceed poll by >=10 seconds.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=45
TELEGRAM_POLL_TIMEOUT_SECONDS=15

# Optional Tailscale CLI path (existing Funnel is inspected, never created automatically).
TAILSCALE_PATH=
