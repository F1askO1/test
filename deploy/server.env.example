NODE_ENV=production
DEV_AUTH=false
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=/var/lib/slopemate/slopemate.sqlite
BOT_ENABLED=true
BOT_LOCK_DIRECTORY=/run/slopemate
BOT_TOKEN=
APP_URL=https://app.example.com
# Direct Telegram API from the server. Use a proxy only if this server requires one.
TELEGRAM_PROXY_URL=
TELEGRAM_CONNECT_TIMEOUT_MS=10000
TELEGRAM_REQUEST_TIMEOUT_SECONDS=45
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TRUST_PROXY=1
CORS_ORIGINS=
# prepare-env generates these locally; deployment ID is public, diagnostics token is secret.
DEPLOYMENT_ID=
DIAGNOSTICS_TOKEN=
